{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatory.local/schemas/human_observation.schema.json",
  "title": "Exploratory Human Research Note",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "record_type", "pair_id", "company_a", "company_b", "year", "quarter", "chart_type", "observation_text", "tags", "hypothesis", "counter_hypothesis", "alternative_explanation", "evidence_needed", "confidence", "created_at", "updated_at", "author", "prohibited_uses"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "record_type": {"const": "exploratory_human_note"},
    "pair_id": {"type": "string", "pattern": "^[0-9]{6}/[0-9]{6}$"},
    "company_a": {"type": "string", "pattern": "^[0-9]{6}$"},
    "company_b": {"type": "string", "pattern": "^[0-9]{6}$"},
    "year": {"type": "integer", "minimum": 1900},
    "quarter": {"type": "string", "pattern": "^[0-9]{4}Q[1-4]$"},
    "chart_type": {"enum": ["return_overlay", "normalized_price", "return_scatter", "lag_correlation", "event_response"]},
    "observation_text": {"type": "string"},
    "tags": {"type": "array", "items": {"enum": ["synchronous", "possible catch-up", "possible reversal", "persistent divergence", "stock-specific outlier", "stock-specific event", "sector-wide move", "possible regime change", "unclear"]}, "uniqueItems": true},
    "hypothesis": {"type": "string"},
    "counter_hypothesis": {"type": "string"},
    "alternative_explanation": {"type": "string"},
    "evidence_needed": {"type": "string"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "author": {"type": "string"},
    "prohibited_uses": {"type": "array", "allOf": [{"contains": {"const": "training labels"}}, {"contains": {"const": "trading signals"}}, {"contains": {"const": "confirmatory evidence"}}]}
  }
}
